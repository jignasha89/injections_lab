  {"id": "sqli-086", "family": "sqli", "subtype": "comment_variation", "payload_string": "' OR 1=1# ", "context": "Hash comment variation", "description": "SQL comment using hash symbol (MySQL)", "references": ["https://dev.mysql.com/doc/refman/8.0/en/comments.html"]},
