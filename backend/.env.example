PORT=5000
FRONTEND_URL=http://localhost:3000
MONGODB_URI=mongodb://localhost:27017/injectionlab

# Active scanner safety gate. Only explicitly authorized lab hosts belong here.
# Example local labs:
SCAN_ALLOWED_HOSTS=*

SCAN_MAX_PAGES=20
SCAN_MAX_PARAMETERS=80
SCAN_CONCURRENCY=4
SCAN_TIMEOUT_MS=8000
SCAN_MAX_BODY_BYTES=750000
SCAN_USER_AGENT=InjectionLab-SecurityScanner/1.0 (+authorized-assessment)
# OpenAI API Key for AI Chat Board (Leave empty for simulated mode, or provide sk-... for gpt-4o-mini)
OPENAI_API_KEY=your_openai_api_key_here

# Cryptographic Master Key for AES-256-GCM at-rest database encryption (Generate via: openssl rand -hex 32)
DB_ENCRYPTION_KEY=generate_64_hex_chars_here

# Admin Session & Access Security
ADMIN_JWT_SECRET=admin_dedicated_jwt_secret_change_in_production
SESSION_TIMEOUT_MINUTES=15
