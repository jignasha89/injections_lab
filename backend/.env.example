# InjectionLab Backend — Production Environment Template

# Server Port (Render automatically assigns PORT)
PORT=5000
NODE_ENV=production

# Frontend Origin for CORS (Your live Vercel URL)
FRONTEND_URL=https://your-frontend-project.vercel.app

# JWT Authentication Secrets (Replace with strong random strings in production)
JWT_SECRET=injectionlab_super_secret_jwt_key_2024_change_in_production
JWT_REFRESH_SECRET=injectionlab_refresh_secret_2024_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Database Configuration (Choose either MongoDB Atlas or In-Memory Mode)
# 1. Standalone zero-setup in-memory mode (Default recommended for quick deploy):
USE_MEMORY_DB=true

# 2. Or MongoDB Atlas connection string (Optional):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/injectionlab?retryWrites=true&w=majority
